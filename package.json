{
  "name": "tboi-codex-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,ts,tsx,css}\" \"backend/src/**/*.js\"",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,ts,tsx,css}\" \"backend/src/**/*.js\"",
    "prepare": "husky",
    "setup": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "eslint --fix --config frontend/eslint.config.js",
      "prettier --write"
    ],
    "backend/src/**/*.js": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.4.0"
  }
}
